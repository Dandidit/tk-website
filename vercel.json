{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/neon-auth/:path*",
      "destination": "/api/neon-auth?path=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/reminders",
      "schedule": "0 1 * * *"
    }
  ]
}